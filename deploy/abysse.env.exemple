# /etc/abysse/abysse.env (droits 600, propriétaire abysse). Chargé par systemd.
# Une source sans URL (ou sans hôte) est simplement ignorée : tout est facultatif.

ABYSSE_ECOUTE_HOTE=0.0.0.0
ABYSSE_ECOUTE_PORT=80
ABYSSE_BASE=/var/lib/abysse/abysse.db
ABYSSE_DOSSIER_WEB=/opt/abysse/web
ABYSSE_SITES_JSON=/etc/abysse/sites.json
# Description des équipements fixes (routeur, box, NAS, PBS...) : voir inventaire.exemple.json
ABYSSE_INVENTAIRE=/etc/abysse/inventaire.json

# MikroTik : utilisateur REST en lecture seule
ABYSSE_MIKROTIK_URL=http://192.168.10.198/rest
ABYSSE_MIKROTIK_USER=abysse
ABYSSE_MIKROTIK_PASS=

# Proxmox VE : jeton d'API au format utilisateur@realm!nom=secret (rôle PVEAuditor)
ABYSSE_PVE_URL=https://192.168.10.97:8006/api2/json
ABYSSE_PVE_JETON=
ABYSSE_PVE_CA=/etc/abysse/pve-ca.pem
ABYSSE_PVE_NOEUD=pve

# Onduleur : serveur NUT (upsd), sans compte
ABYSSE_NUT_HOTE=
ABYSSE_NUT_PORT=3493
ABYSSE_NUT_UPS=onduleur

# InfluxDB 2 : jeton en lecture sur les buckets "homelab" et "proxmox"
ABYSSE_INFLUX_URL=
ABYSSE_INFLUX_JETON=
ABYSSE_INFLUX_ORG=homelab

# TrueNAS : utilisateur en lecture seule et sa clé d'API (format <id>-<secret>)
ABYSSE_TRUENAS_URL=
ABYSSE_TRUENAS_UTILISATEUR=abysse
ABYSSE_TRUENAS_CLE=
ABYSSE_TRUENAS_CA=

# Phare (facultatif) : liste des sites lue en direct dans Caddy
ABYSSE_PHARE_URL=
